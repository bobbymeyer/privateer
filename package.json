{
  "name": "privateer",
  "private": true,
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test": "node --test --experimental-strip-types --disable-warning=ExperimentalWarning src/*.test.ts src/world/*.test.ts src/ui/*.test.ts",
    "play": "node --experimental-strip-types --disable-warning=ExperimentalWarning cli/play.ts",
    "sim": "node --experimental-strip-types --disable-warning=ExperimentalWarning cli/sim.ts",
    "rumors": "node --experimental-strip-types --disable-warning=ExperimentalWarning cli/rumors.ts",
    "chart": "node --experimental-strip-types --disable-warning=ExperimentalWarning cli/chart.ts",
    "world": "node --max-old-space-size=4096 --experimental-strip-types --disable-warning=ExperimentalWarning scripts/build-world.ts",
    "coast": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/build-coast.ts",
    "voyage": "node --experimental-strip-types --disable-warning=ExperimentalWarning cli/voyage.ts"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/node": "^22.20.5",
    "d3-geo-voronoi": "^2.1.0",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.7",
    "typescript": "~5.9.3",
    "vite": "^8.3.5"
  }
}
